<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.llm-secret-manager.mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__REPO__/mcp/nv-mcp.py</string>
		<string>--http</string>
		<string>__PORT__</string>
	</array>
	<!-- BWV_BOOTSTRAP names the keychain item holding the Bitwarden master
	     password. Without it the bw_* tools cannot unlock the vault, while the
	     keychain-only secret_* tools keep working. It is an item NAME, not a
	     secret. Empty when the installer was run without BWV_BOOTSTRAP set.
	     PATH is explicit because a LaunchAgent inherits none, and `bw` lives
	     in a Homebrew prefix. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>BWV_BOOTSTRAP</key>
		<string>__BWV_BOOTSTRAP__</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<!-- Aqua only: the whole point is running inside the logged-in GUI
	     session, where the login keychain is unlocked. When nobody is
	     logged in, the server is down and the vault is sealed — that is
	     the native semantic, not a bug. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/llm-secret-manager-mcp.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/llm-secret-manager-mcp.log</string>
</dict>
</plist>
