#!/usr/bin/env bash
#
# with-secrets - inject secrets from the macOS Keychain into a process without
# the value ever reaching stdout or stderr.
#
#   with-secrets VAR=keychain-service [VAR2=service2 ...] -- command [args...]
#   with-secrets --check VAR=keychain-service [...]
#
# Lookup is by service attribute (-s). If several items share a service name
# under different accounts, also set $KEYCHAIN_ACCOUNT; -a is then passed along.
#
# Threat model: prevents accidental leaks, not deliberate reads. Anyone who can
# run this script can make it print a secret (-- sh -c 'echo $VAR').
# See README, "Limits".

set -euo pipefail

usage() {
	cat >&2 <<'EOF'
usage: with-secrets VAR=keychain-service [...] -- command [args...]
       with-secrets --check VAR=keychain-service [...]

  VAR               name of the environment variable in the target process
  keychain-service  value of the -s attribute in the Keychain

  --check           resolve secrets and report length only, do not run anything

  KEYCHAIN_ACCOUNT  optional, narrows the lookup by -a as well.
                    Without it, lookup is by -s only.
EOF
	exit 64
}

die() {
	echo "with-secrets: $1" >&2
	exit "${2:-1}"
}

check_only=0
if [ "${1:-}" = "--check" ]; then
	check_only=1
	shift
fi

[ $# -gt 0 ] || usage

account="${KEYCHAIN_ACCOUNT:-}"
names=()

while [ $# -gt 0 ] && [ "$1" != "--" ]; do
	mapping="$1"
	shift

	case "$mapping" in
	*=*) ;;
	*) die "expected VAR=service, got '$mapping'" 64 ;;
	esac

	var="${mapping%%=*}"
	item="${mapping#*=}"

	# The variable name is validated because it is used in an eval below.
	# macOS ships bash 3.2, which has no namerefs (declare -n).
	if ! printf '%s' "$var" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$'; then
		die "invalid variable name '$var'" 64
	fi
	[ -n "$item" ] || die "empty Keychain service for '$var'" 64

	# stderr from security is discarded: its message never contains the value,
	# but the exit code is enough and our own message is more precise.
	if [ -n "$account" ]; then
		value="$(security find-generic-password -s "$item" -a "$account" -w 2>/dev/null)" || \
			die "no Keychain item for service='$item' account='$account'"
	else
		value="$(security find-generic-password -s "$item" -w 2>/dev/null)" || \
			die "no Keychain item for service='$item'"
	fi
	[ -n "$value" ] || die "Keychain item '$item' is empty"

	export "$var=$value"
	unset value
	names[${#names[@]}]="$var"
done

[ ${#names[@]} -gt 0 ] || die "no VAR=service pairs given" 64

if [ "$check_only" -eq 1 ]; then
	for var in "${names[@]}"; do
		eval "len=\${#$var}"
		printf '%s: set, %s characters\n' "$var" "$len"
	done
	exit 0
fi

[ "${1:-}" = "--" ] || die "missing '--' before the command" 64
shift
[ $# -gt 0 ] || die "no command after '--'" 64

exec "$@"
